{
    "manifest_version": 3,
    "name": "Focus App",
    "version": "1.0",
    "action": {
      "default_popup": "popup.html"
    },
    "permissions": [
      "storage",
      "declarativeNetRequest"
    ],
    "host_permissions": [
      "*://*.instagram.com/*",
      "*://*.youtube.com/*",
      "*://*.netflix.com/*"
    ],
    "declarative_net_request": {
      "rule_resources": []
    }
  }
  