{
    "manifest_version": 3,
    "name": "Focus App",
    "version": "1.0",
  
    "action": {
      "default_popup": "popup.html"
    },
  
    "permissions": [
      "storage",
      "declarativeNetRequest"
    ],
  
    "host_permissions": [
      "*://*.instagram.com/*",
      "*://*.youtube.com/*",
      "*://*.netflix.com/*",
      "https://undelved-censorable-ethan.ngrok-free.dev/*",
      "https://student-focus-app-1.onrender.com/*"
    ],
  
    "background": {
      "service_worker": "background.js"
    },
  
    "declarative_net_request": {
      "rule_resources": []
    },
  
    "content_scripts": [
      {
        "matches": [
          "https://student-focus-app-1.onrender.com/*"
        ],
        "js": ["site-bridge.js"],
        "run_at": "document_idle"
      }
    ]
  }
  
  
  